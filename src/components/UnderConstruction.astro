---
import "@fontsource/instrument-serif/latin-400.css";
import "@fontsource/dm-mono/latin-400.css";
import { Image } from "astro:assets";
import staircase from "../assets/staircase.png";
import "../styles/global.css";

const colors = {
	paper: "#f5f1e8",
	ink: "#2148b8",
};
---

<html
	lang="en"
	style={{
		"--color-paper": colors.paper,
		"--color-ink": colors.ink,
		"--color-divider": `${colors.ink}4d`,
	}}
>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content={colors.paper} />
		<meta
			name="description"
			content="Mahiro Sakaue’s portfolio is under construction. Please check back soon."
		/>
		<link rel="canonical" href={Astro.site} />
		<title>Mahiro Sakaue</title>
	</head>
	<body>
		<div class="page">
			<header class="masthead">
				<p class="name">Mahiro Sakaue</p>
			</header>
			<main>
				<div class="intro">
					<h1>Under<br />construction.</h1>
					<p class="description">
						My portfolio is being built.<br />Please check back soon.
					</p>
				</div>
				<figure class="illustration" aria-hidden="true">
					<Image
						src={staircase}
						alt=""
						width={1000}
						widths={[400, 700, 1000]}
						sizes="(max-width: 600px) 72vw, 54vw"
						format="webp"
						quality={85}
						loading="eager"
						fetchpriority="high"
					/>
				</figure>
			</main>
			<footer>
				<a href="https://github.com/mahhie393"
					>GitHub <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"
						><path d="M5 19 19 5M5 5h14v14"></path></svg
					></a
				>
				<a href="https://www.linkedin.com/in/mahhie393/"
					>LinkedIn <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"
						><path d="M5 19 19 5M5 5h14v14"></path></svg
					></a
				>
				<p class="copyright">© {new Date().getFullYear()} Mahiro Sakaue</p>
			</footer>
		</div>
	</body>
</html>

<style>
	:global(html) {
		background: var(--color-paper);
		color: var(--color-ink);
		color-scheme: light;
	}
	:global(body) {
		margin: 0;
		font-family: "DM Mono", monospace;
		-webkit-font-smoothing: antialiased;
	}
	:global(::selection) {
		background: var(--color-ink);
		color: var(--color-paper);
	}
	.page {
		min-height: 100svh;
		display: grid;
		grid-template-rows: auto 1fr auto;
		padding: clamp(20px, 3.5vw, 56px) clamp(24px, 4.5vw, 80px);
	}
	.masthead {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 20px;
		padding-bottom: 23px;
		border-bottom: 1px solid var(--color-divider);
	}
	.name {
		font-size: 17px;
		letter-spacing: -0.06em;
	}
	main {
		position: relative;
		isolation: isolate;
		display: flex;
		align-items: center;
		min-height: 0;
		padding-block: 40px;
		background: var(--color-paper);
	}
	.intro {
		position: relative;
		z-index: 1;
		width: 46%;
		margin-right: auto;
	}
	h1 {
		font-family: "Instrument Serif", Georgia, serif;
		font-size: clamp(38px, min(7.5vw, 15svh), 144px);
		font-weight: 400;
		line-height: 0.95;
		letter-spacing: -0.035em;
	}
	.description {
		margin-top: clamp(28px, 5svh, 54px);
		font-size: 12px;
		line-height: 1.8;
		letter-spacing: -0.02em;
	}
	.illustration {
		position: absolute;
		z-index: -1;
		right: 0;
		top: 50%;
		width: min(54vw, calc(100svh - 250px), 900px);
		transform: translateY(-49%);
		mix-blend-mode: multiply;
	}
	.illustration img {
		display: block;
		width: 100%;
		height: auto;
		filter: brightness(1.1);
	}
	footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 24px;
		border-top: 1px solid var(--color-divider);
		padding-top: 20px;
		font-size: 11px;
	}
	footer a {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 44px;
		margin-block: -10px;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 5px;
	}
	footer a:hover {
		text-decoration-thickness: 2px;
	}
	footer a:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 5px;
	}
	footer svg {
		width: 13px;
		height: 13px;
		stroke: currentColor;
		stroke-width: 1.5;
	}
	.copyright {
		margin-left: auto;
		text-align: right;
		white-space: nowrap;
	}
	@media (max-width: 600px) and (min-height: 451px) {
		.page {
			padding-block: 24px;
		}
		.masthead {
			padding-bottom: 18px;
		}
		.name {
			font-size: 14px;
		}
		main {
			padding-block: clamp(28px, 5svh, 48px) 24px;
		}
		h1 {
			font-size: min(13vw, 10svh);
		}
		.description {
			margin-top: 24px;
			font-size: 10px;
		}
		.illustration {
			width: min(72vw, max(80px, calc(100svh - 430px)));
		}
		footer {
			gap: 16px;
			padding-top: 16px;
			font-size: 10px;
		}
	}
	@media (max-width: 600px) and (min-height: 451px) and (max-height: 740px) {
		.page {
			padding-block: 18px;
		}
		.masthead {
			padding-bottom: 12px;
		}
		main {
			padding-top: 24px;
		}
	}

	@media (max-height: 700px) and (min-width: 601px), (max-height: 450px) {
		.page {
			padding-block: 20px;
		}
		.masthead {
			padding-bottom: 12px;
		}
		main {
			padding-block: 24px;
		}
		.description {
			margin-top: 22px;
			font-size: 10px;
		}
		.illustration {
			width: min(48vw, 64svh);
		}
		footer {
			padding-top: 12px;
		}
	}

	@media (max-height: 450px) {
		.page {
			padding-block: 14px;
		}
		.masthead {
			padding-bottom: 10px;
		}
		.name {
			font-size: 14px;
		}
		main {
			padding-block: 14px;
		}
		h1 {
			font-size: min(8.7vw, 16svh);
		}
		.description {
			margin-top: 16px;
			font-size: 9px;
		}
		.illustration {
			width: min(44vw, 60svh);
		}
		footer {
			font-size: 9px;
		}
	}

	@media (min-width: 601px) and (max-width: 900px) and (min-height: 701px),
		(min-width: 601px) and (min-height: 701px) and (orientation: portrait) {
		h1 {
			font-size: 10vw;
		}
	}

	@media (max-width: 600px) and (min-height: 451px),
		(min-width: 601px) and (max-width: 900px) and (min-height: 701px),
		(min-width: 601px) and (min-height: 701px) and (orientation: portrait) {
		.page {
			height: 100svh;
		}
		main {
			display: grid;
			/* Short screens can use the illustration's empty upper-left space. */
			grid-template-rows: minmax(0, max-content) max-content;
			align-content: center;
			align-items: start;
			gap: clamp(16px, 3svh, 32px);
		}
		.intro {
			width: 100%;
			min-height: 0;
			margin-right: 0;
		}
		.illustration {
			position: relative;
			inset: auto;
			justify-self: center;
			transform: none;
		}
	}
</style>
